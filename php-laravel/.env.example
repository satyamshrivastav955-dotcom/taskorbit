APP_NAME=TaskOrbit-Notes
# Generate with: php artisan key:generate (never commit the real value)
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taskorbit_reports
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=local

# Session cookie hardening. Set SESSION_SECURE_COOKIE=true when serving over HTTPS.
SESSION_SECURE_COOKIE=false
