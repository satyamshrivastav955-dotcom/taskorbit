# Copy to .env for local dev. Never commit .env.
VITE_FIREBASE_API_KEY=placeholder
VITE_FIREBASE_AUTH_DOMAIN=placeholder.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=placeholder
VITE_FIREBASE_STORAGE_BUCKET=placeholder.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=placeholder
VITE_FIREBASE_APP_ID=placeholder
VITE_API_BASE_URL=http://localhost:4000/api
VITE_ANALYTICS_URL=http://localhost:8081/api/analytics
VITE_JSP_REPORT_URL=http://localhost:8080/servlet-jsp
VITE_LARAVEL_NOTES_URL=http://localhost:8000
# --- Supabase (Safe Frontend Client - RLS Protected) ---
# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Project Settings -> API -> anon public key (DO NOT use service_role key here)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
