service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{projectId}/requirements/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'client';
    }
    match /projects/{projectId}/submissions/{taskId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'assignee';
    }
    match /projects/{projectId}/final/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
