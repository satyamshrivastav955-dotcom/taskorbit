// Phase 0 placeholder. Full rules land in Phase 2 (v1) and Phase 8 (hardened).
// Principle: frontend role checks are UX only; real enforcement is
// Express middleware + these rules. Deny by default until Phase 2.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
