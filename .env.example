# Root placeholders. Copy the relevant block into each service .env file.
# Never commit real values or service-account keys.

# --- Frontend (frontend/.env) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_API_BASE_URL=http://localhost:4000/api
# VITE_ANALYTICS_URL=http://localhost:8081/api/analytics
# VITE_JSP_REPORT_URL=http://localhost:8080/servlet-jsp
# VITE_LARAVEL_NOTES_URL=http://localhost:8000

# --- Node backend (node-backend/.env) ---
# PORT=4000
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/serviceAccountKey.json
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=taskorbit_reports

# --- Spring Boot (springboot-service/src/main/resources/application.properties) ---
# server.port=8081
# spring.datasource.url=jdbc:mysql://127.0.0.1:3306/taskorbit_reports
# spring.datasource.username=root
# spring.datasource.password=
# app.api-key=change-me-in-env

# --- Servlet/JSP (servlet-jsp/src/main/resources/db.properties + env) ---
# DB_URL=jdbc:mysql://127.0.0.1:3306/taskorbit_reports
# DB_USER=root
# DB_PASSWORD=

# --- Laravel (php-laravel/.env) ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=taskorbit_reports
# DB_USERNAME=root
# DB_PASSWORD=
