# Copy to .env for local dev. Never commit .env or credentials/.
PORT=4000
FIREBASE_PROJECT_ID=placeholder
GOOGLE_APPLICATION_CREDENTIALS=./credentials/serviceAccountKey.json
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=taskorbit_reports

# --- Supabase (PostgreSQL & Sync) ---
# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co
# Project Settings -> API -> service_role key (secret, backend only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Project Settings -> API -> anon public key (optional fallback)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase Storage bucket for project documents, attachments, and submissions
SUPABASE_STORAGE_BUCKET=taskorbit-files

# --- Development Authentication Bypass (Local Dev Only) ---
# Set to 'true' to enable local bypass with engineer1@taskorbit.local. Set to 'false' or omit for real Firebase.
DEV_AUTH_BYPASS=false

