    { "name": "conflicts", "request": { "method": "GET", "url": "{{base}}/api/analytics/conflicts", "header": [{ "key": "X-API-Key", "value": "{{key}}" }] } },
    { "name": "review stats", "request": { "method": "GET", "url": "{{base}}/api/analytics/reviews/stats", "header": [{ "key": "X-API-Key", "value": "{{key}}" }] } },
    { "name": "health", "request": { "method": "GET", "url": "{{base}}/api/analytics/health", "header": [{ "key": "X-API-Key", "value": "{{key}}" }] } }
  ]
